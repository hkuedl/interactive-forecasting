{
  "protocol_version": "public-chronological-source-clock-v2",
  "seed": 0,
  "time_handling": "source_clock_no_timezone_or_dst",
  "task": {
    "delta": 1,
    "horizon": 1,
    "offset_unit": "samples",
    "anchor": "start_at_delta"
  },
  "training": {
    "neural_epochs": 100,
    "neural_batch_size": 64,
    "optimizer": "adam",
    "early_stopping_patience": 10,
    "validation_metric": "mae",
    "weight_decay": 0,
    "gradient_clip_norm": 1.0
  },
  "mape_zero_policy": "omit",
  "quantiles": [0.1, 0.5, 0.9],
  "backend": {
    "sampler": "tpe",
    "seed": 0,
    "direction": "minimize",
    "n_startup_trials": 10,
    "n_ei_candidates": 24,
    "prior_weight": 1.0,
    "consider_magic_clip": true,
    "consider_endpoints": false,
    "gamma_rule": "optuna_builtin",
    "weights_rule": "optuna_builtin",
    "multivariate": false,
    "group": false,
    "warn_independent_sampling": false,
    "constant_liar": false,
    "constraints": "none",
    "trial_budget": 300,
    "batch_size": 10,
    "max_rounds": 30
  },
  "llm": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0
  },
  "datasets": {
    "gefcom2014": {
      "timezone": "source_clock",
      "split": [0.70, 0.15, 0.15]
    },
    "gefcom2012": {
      "timezone": "source_clock",
      "split": [0.70, 0.15, 0.15]
    },
    "gefcom2017": {
      "timezone": "source_clock",
      "split": [0.70, 0.15, 0.15]
    }
  }
}
